<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Qurio" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:disabledAlpha">1.0</item>

        <!-- System Bar Colors -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Make system bars transparent -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <item name="android:textViewStyle">@style/GlobalTextViewStyle</item>
    </style>

    <style name="Theme.Qurio" parent="Base.Theme.Qurio" />



    <style name="Theme.Qurio.SplashScreen" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.Qurio</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_inset</item>
    </style>

   <!--button region-->

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/primary_button_background</item>
        <item name="android:textColor">@color/primary_button_text_color</item>
        <item name="android:textAppearance">@style/Label.Medium</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:disabledAlpha">1.0</item>
    </style>

    <style name="SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/secondary_button_background</item>
        <item name="android:textColor">@color/secondary_button_text_color</item>
        <item name="android:textAppearance">@style/Label.Medium</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:disabledAlpha">1.0</item>
    </style>

    <style name="TextButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/transparent</item>
        <item name="android:textColor">@color/secondary_button_text_color</item>
        <item name="android:textAppearance">@style/Label.Medium</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LargePlayNowButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineHeight">22dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:fontFamily">@font/fredoka_one_regular</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:background">@drawable/large_play_now_background</item>
    </style>
    <style name="SmallPlayNowButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineHeight">16dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/fredoka_one_regular</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:background">@drawable/small_play_now_background</item>
    </style>
    <!--end region-->

    <!-- Chip Style -->
    <style name="ChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="chipBackgroundColor">@color/surface_high</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <!-- Dialog Animation -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

</resources>