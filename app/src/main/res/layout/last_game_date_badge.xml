<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <View
        android:id="@+id/left_gradient"
        android:layout_width="56dp"
        android:layout_height="1dp"
        android:background="@drawable/blue_linear_gradiant"
        android:rotation="180"
        android:translationX="5dp"
        app:layout_constraintEnd_toStartOf="@id/date_shape"
        app:layout_constraintTop_toTopOf="@id/last_game_card" />

    <View
        android:id="@+id/right_gradient"
        android:layout_width="56dp"
        android:layout_height="1dp"
        android:background="@drawable/blue_linear_gradiant"
        android:translationX="-5dp"
        app:layout_constraintStart_toEndOf="@id/date_shape"
        app:layout_constraintTop_toTopOf="@id/last_game_card" />

    <FrameLayout
        android:id="@+id/date_shape"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="91dp"
        app:layout_constraintBottom_toTopOf="@id/game_title"
        app:layout_constraintDimensionRatio="145:40"
        app:layout_constraintEnd_toEndOf="@id/last_game_card"
        app:layout_constraintStart_toStartOf="@id/last_game_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="spread_inside">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_margin="4dp"
            android:backgroundTint="@color/transparent"
            android:outlineSpotShadowColor="#49BAF2"
            app:cardCornerRadius="50dp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/date_shampe"
            android:elevation="5dp"
            android:src="@drawable/game_date" />
    </FrameLayout>

    <TextView
        android:id="@+id/date"
        style="@style/Label.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:textColor="@color/on_primary"
        app:layout_constraintBottom_toBottomOf="@+id/date_shape"
        app:layout_constraintEnd_toEndOf="@id/date_shape"
        app:layout_constraintStart_toStartOf="@id/date_shape"
        app:layout_constraintTop_toTopOf="@id/date_shape"
        tools:text="03-08-2025" />
</merge>