<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="328dp"
    android:layout_height="273dp">

    <View
        android:id="@+id/edges_background"
        android:layout_width="328dp"
        android:layout_height="260dp"
        android:background="@drawable/characters_dialog_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <View
        android:id="@+id/blue_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/blue_radiant_gradiant"
        app:layout_constraintTop_toTopOf="@id/edges_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageView
        android:id="@+id/character_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/character_dialog_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <ImageView
        android:id="@+id/close_button"
        android:layout_width="22dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_close_character_dialog"
        app:layout_constraintTop_toTopOf="@id/edges_background"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <com.bucharest.qurio.view.DifficultyLevelButton
        android:id="@+id/easy_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/confirm_button"
        android:layout_marginBottom="52dp"
        android:layout_marginStart="12dp"
        android:text="Easy"
        />
    <com.bucharest.qurio.view.DifficultyLevelButton
        android:id="@+id/medium_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toStartOf="@id/hard_button"
        app:layout_constraintBottom_toTopOf="@id/confirm_button"
        android:layout_marginBottom="52dp"
        app:layout_constraintStart_toEndOf="@id/easy_button"
        android:text="Medium"
        />
    <com.bucharest.qurio.view.DifficultyLevelButton
        android:id="@+id/hard_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:enabled="true"

        app:layout_constraintBottom_toTopOf="@id/confirm_button"
        android:layout_marginBottom="52dp"
        app:layout_constraintStart_toEndOf="@id/medium_button"
        android:text="Hard"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Difficulty level"
        style="@style/Title.Small"
        android:layout_marginTop="8dp"
        android:textColor="@color/on_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/confirm_button"
        style="@style/PrimaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="36dp"
        android:enabled="false"
        android:text="Confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/cancel_button"
        style="@style/SecondaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="36dp"
        android:enabled="true"
        android:text="Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />



</androidx.constraintlayout.widget.ConstraintLayout>